NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback: optional when using a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-only random secret (at least 32 characters) for the publishing cron.
CRON_SECRET=

# Server-only random secret (at least 32 characters) for public-form HMAC keys.
# Required for submissions; keep stable across instances and deployments.
PUBLIC_FORM_SECRET=
# Self-hosted ingress only: x-real-ip or x-forwarded-for (one IP, overwritten
# by your proxy). Vercel uses x-vercel-forwarded-for automatically.
# Unset/missing/invalid IPs share one conservative network bucket.
PUBLIC_FORM_IP_HEADER=

# Canonical HTTP(S) origin and trusted Auth email redirect origin.
# Set the real public domain before production build; configure Supabase SMTP,
# Confirm email, redirect allowlist and token-hash templates as described in README.
# No credentials, subpath, query parameters or fragment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=

# Transactional email queue. Verify EMAIL_FROM in Resend before enabling cron.
RESEND_API_KEY=
EMAIL_FROM=SMU <notifications@example.kz>
NEXT_PUBLIC_POSTHOG_KEY=
